generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RequiredRole {
  ADMIN
  TECHNICIAN
  RESEARCHER
}

enum TaskEventType {
  TASK_UPDATED
  DEADLINE_SET
  DEADLINE_CLEARED
  ATTACHMENT_ADDED
  ATTACHMENT_UPDATED
  ATTACHMENT_REMOVED
  REMINDER_SENT
}

model GuildConfig {
  id                              Int           @id @default(autoincrement())
  guildId                         String        @unique
  dashboardChannelId              String
  dashboardSummaryMessageId       String?
  feedChannelId                   String
  archiveChannelId                String?
  adminRoleId                     String
  secondaryManagerRoleId          String?
  reviewerRoleId                  String?
  secondaryReviewerRoleId         String?
  maxActiveTasksPerUser           Int      @default(2)
  defaultThreadAutoArchiveMinutes Int      @default(1440)
  nextTaskNumber                  Int      @default(1)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime      @updatedAt
  tasks                           Task[]
}

model Task {
  id                     Int                 @id @default(autoincrement())
  taskCode               String
  taskNumber             Int
  guildId                String
  title                  String
  description            String
  requiredRole           RequiredRole
  priority               TaskPriority        @default(MEDIUM)
  targetMemberCount      Int                 @default(1)
  status                 TaskStatus          @default(BACKLOG)
  createdByDiscordUserId String
  assigneeDiscordUserId  String?
  taskMessageChannelId   String?
  taskMessageId          String?
  threadChannelId        String?
  blockedReason          String?
  deadlineAt             DateTime?
  reviewRequestedAt      DateTime?
  completedAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  guildConfig            GuildConfig         @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  attachments            TaskAttachment[]
  reminderReceipts       TaskReminderReceipt[]
  events                 TaskEvent[]
  members                TaskMember[]
  statusHistory          TaskStatusHistory[]

  @@unique([guildId, taskCode])
  @@unique([guildId, taskNumber])
  @@index([guildId, status])
  @@index([assigneeDiscordUserId, status])
}

model TaskMember {
  id            Int      @id @default(autoincrement())
  taskId         Int
  discordUserId  String
  joinedAt       DateTime @default(now())
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, discordUserId])
  @@index([discordUserId])
  @@index([taskId, joinedAt])
}

model TaskStatusHistory {
  id                  Int         @id @default(autoincrement())
  taskId              Int
  actorDiscordUserId  String
  fromStatus          TaskStatus?
  toStatus            TaskStatus
  reason              String?
  createdAt           DateTime    @default(now())
  task                Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model TaskAttachment {
  id                  Int      @id @default(autoincrement())
  taskId               Int
  label                String?
  url                  String
  fileName             String?
  contentType          String?
  sizeBytes            Int?
  addedByDiscordUserId String
  createdAt            DateTime @default(now())
  task                 Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model TaskReminderReceipt {
  id                  Int      @id @default(autoincrement())
  taskId               Int
  recipientDiscordUserId String
  reminderKey         String
  sentAt              DateTime @default(now())
  task                Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, recipientDiscordUserId, reminderKey])
  @@index([recipientDiscordUserId, sentAt])
}

model TaskEvent {
  id                  Int           @id @default(autoincrement())
  taskId              Int
  actorDiscordUserId  String?
  type                TaskEventType
  summary             String
  details             String?
  createdAt           DateTime      @default(now())
  task                Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([type, createdAt])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RequiredRole {
  ADMIN
  TECHNICIAN
  RESEARCHER
}

model GuildConfig {
  id                             Int      @id @default(autoincrement())
  guildId                        String   @unique
  dashboardChannelId             String
  dashboardSummaryMessageId      String?
  feedChannelId                  String
  archiveChannelId               String?
  adminRoleId                    String
  reviewerRoleId                 String?
  maxActiveTasksPerUser          Int      @default(2)
  defaultThreadAutoArchiveMinutes Int     @default(1440)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
  tasks                          Task[]
}

model Task {
  id                     Int                 @id @default(autoincrement())
  taskCode               String
  guildId                String
  title                  String
  description            String
  requiredRole           RequiredRole
  priority               TaskPriority        @default(MEDIUM)
  targetMemberCount      Int                 @default(1)
  status                 TaskStatus          @default(BACKLOG)
  createdByDiscordUserId String
  assigneeDiscordUserId  String?
  taskMessageChannelId   String?
  taskMessageId          String?
  threadChannelId        String?
  blockedReason          String?
  deadlineAt             DateTime?
  reviewRequestedAt      DateTime?
  completedAt            DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  guildConfig            GuildConfig         @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  members                TaskMember[]
  statusHistory          TaskStatusHistory[]

  @@unique([guildId, taskCode])
  @@index([guildId, status])
  @@index([assigneeDiscordUserId, status])
}

model TaskMember {
  id            Int      @id @default(autoincrement())
  taskId         Int
  discordUserId  String
  joinedAt       DateTime @default(now())
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, discordUserId])
  @@index([discordUserId])
  @@index([taskId, joinedAt])
}

model TaskStatusHistory {
  id                  Int         @id @default(autoincrement())
  taskId              Int
  actorDiscordUserId  String
  fromStatus          TaskStatus?
  toStatus            TaskStatus
  reason              String?
  createdAt           DateTime    @default(now())
  task                Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}
